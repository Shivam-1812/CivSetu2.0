# Copy to backend/.env and fill in. backend/.env is git-ignored.

# --- Local PostGIS (docker compose) ---
POSTGRES_DB=civsetu
POSTGRES_USER=civsetu
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# --- pgAdmin (http://localhost:5050) ---
PGADMIN_PORT=5050

# --- First Admin, created on startup when no Admin exists (min 8 characters) ---
CIVSETU_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
CIVSETU_BOOTSTRAP_ADMIN_PASSWORD=

# --- Login ---
# Access-token signing key, at least 32 characters. Generate one, e.g. in PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
CIVSETU_JWT_SECRET=
# Frontend origin(s) allowed to call the API (comma-separated)
CIVSETU_CORS_ORIGINS=http://localhost:5173
# Strict when frontend and API share a site; None in production if they are on different sites
CIVSETU_REFRESH_COOKIE_SAMESITE=Strict

# --- Media storage: local (default, files in backend/uploads) or s3 (Cloudflare R2 etc.) ---
CIVSETU_MEDIA_STORAGE=local
# CIVSETU_MEDIA_ROOT=./uploads
# For s3 / Cloudflare R2 (endpoint https://<account-id>.r2.cloudflarestorage.com, region auto):
# CIVSETU_S3_ENDPOINT=
# CIVSETU_S3_REGION=auto
# CIVSETU_S3_BUCKET=
# CIVSETU_S3_ACCESS_KEY=
# CIVSETU_S3_SECRET_KEY=

# --- Production only (profile prod) ---
# DB_URL=jdbc:postgresql://host:5432/civsetu
# DB_USERNAME=
# DB_PASSWORD=
